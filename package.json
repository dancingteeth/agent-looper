{
  "name": "@dancingteeth/agent-looper",
  "version": "0.1.9",
  "description": "Agent Looper — repo-agnostic fix-until-green harness (Cursor / Cline / OpenCode / Pi; configurable reviewRuntime judge)",
  "license": "MIT",
  "type": "module",
  "author": "Paul Zgordan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dancingteeth/agent-looper.git"
  },
  "bin": {
    "agent-loop": "./dist/cli/run.js",
    "agent-loop-batch": "./dist/cli/run-batch.js",
    "agent-check": "./dist/cli/check.js",
    "agent-loop-init": "./dist/cli/init.js",
    "agent-loop-review-run": "./dist/cli/review-run.js",
    "agent-loop-review-preview": "./dist/cli/review-preview.js",
    "agent-loop-meta-review": "./dist/cli/meta-review.js",
    "agent-loop-doctor": "./dist/cli/doctor.js",
    "agent-loop-export-run": "./dist/cli/export-run.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "scripts/dist-manifest.json",
    "scripts/prepare-package.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli/*.js",
    "prepare": "node scripts/prepare-package.mjs",
    "test:prepare": "node --test scripts/prepare-package.test.mjs",
    "ensure-link": "bash scripts/ensure-file-dep-link.sh",
    "test": "vitest run && node --test scripts/prepare-package.test.mjs",
    "test:coverage": "vitest run --coverage && node --test scripts/prepare-package.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "agent:init": "node dist/cli/init.js",
    "agent:loop": "doppler run --project agent-looper --config dev -- node dist/cli/run.js",
    "agent:check": "doppler run --project agent-looper --config dev -- node dist/cli/check.js cursor",
    "agent:check:cline": "doppler run --project agent-looper --config dev -- node dist/cli/check.js cline",
    "agent:check:opencode": "doppler run --project agent-looper --config dev -- node dist/cli/check.js opencode",
    "agent:check:pi": "doppler run --project agent-looper --config dev -- node dist/cli/check.js pi",
    "agent:doctor": "doppler run --project agent-looper --config dev -- node dist/cli/doctor.js",
    "test:cursor-plugin": "node scripts/validate-cursor-plugin.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "^4.3.4"
  },
  "peerDependencies": {
    "@cline/sdk": ">=0.0.55",
    "@cursor/sdk": ">=1.0.18",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@opencode-ai/sdk": ">=1.18.0",
    "opencode-ai": ">=1.18.0"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    },
    "@cursor/sdk": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "opencode-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cline/sdk": "^0.0.55",
    "@cursor/sdk": "^1.0.18",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@opencode-ai/sdk": "^1.18.15",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.9",
    "opencode-ai": "^1.18.15",
    "typescript": "^5.8.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
