{
  "runtime": "cline-pass",
  "model": "cline-pass/deepseek-v4-flash",
  "reasoningEffort": "medium",
  "escalateReasoningEffort": "xhigh",
  "reasoningEscalationStep": 1,
  "maxIterations": 8,
  "verify": "bash .cursor/loops/example-fix/verify.sh",
  "postQualityReview": "auto",
  "reviewRisk": "auto",
  "reviewGate": false,
  "maxReviewCycles": 2,
  "syncOnSuccess": true,
  "stagnationThreshold": 3,
  "mode": "forward",
  "pauseAfterIteration": false,
  "injectFailureContext": false,
  "notifyTelegram": true,
  "verifyLogMode": "inline",
  "plugins": ["templates/agent-plugin.example"]
}