{
  "taskwarriorProject": "my-project",
  "syncCommand": null,
  "notifyWebhook": {
    "onSuccess": true,
    "onFailure": true
  },
  "notifyPrComment": true,
  "defaultBranch": "main",
  "agentsFile": "AGENTS.md",
  "reviewsFile": "REVIEWS.md",
  "skillsGlob": "packages/skills/*/SKILL.md",
  "clientName": "@my-org/my-app",
  "loopRiskProfile": {
    "high": ["stripe-webhook", "crm-admin", "run-sql"],
    "medium": ["checkout", "affiliate"],
    "low": ["copy-only", "readme"]
  },
  "telegramNotify": {
    "onSuccess": true,
    "onFailure": true
  },
  "defaults": {
    "runtime": "dsh",
    "reviewRuntime": "dsh",
    "maxIterations": 8
  }
}
