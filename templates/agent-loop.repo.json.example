{
  "taskwarriorProject": "my-project",
  "syncCommand": null,
  "notifyCommand": "curl -sS -X POST \"$SLACK_WEBHOOK\" -H 'Content-type: application/json' --data \"{\\\"text\\\":\\\"$LOOP_BUNDLE exit $LOOP_EXIT_CODE: $LOOP_REASON\\\"}\"",
  "defaultBranch": "main",
  "agentsFile": "AGENTS.md",
  "reviewsFile": "REVIEWS.md",
  "skillsGlob": "packages/skills/*/SKILL.md",
  "clientName": "@my-org/my-app",
  "loopRiskProfile": {
    "high": ["stripe-webhook", "crm-admin", "run-sql"],
    "medium": ["checkout", "affiliate"],
    "low": ["copy-only", "readme"]
  },
  "telegramNotify": {
    "onSuccess": true,
    "onFailure": true
  }
}
